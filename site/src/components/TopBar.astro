---
// The bar across the top of every view, with the search pill (the pop-up itself is Search.astro) and the
// Map | Trail toggle (client/arrangement.ts), a radio group. Ticket 08 adds the EN | PL switch here.
import { label } from "../labels";
---

<header class="top-bar">
  <p class="logo"><span class="badge" aria-hidden="true">py</span> <span class="site-title">{label("siteTitle")}</span></p>
  <button class="search-pill" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" data-search-open>
    <span class="icon" aria-hidden="true">⌕</span>
    <span class="prompt">{label("searchPrompt")}</span>
    <kbd aria-hidden="true" data-shortcut>Ctrl K</kbd>
  </button>
  <div class="toggle" role="radiogroup" aria-label={label("arrangement")}>
    <label><input type="radio" name="arrangement" value="map" autocomplete="off" checked data-arrangement-choice /><span>{label("map")}</span></label>
    <label><input type="radio" name="arrangement" value="trail" autocomplete="off" data-arrangement-choice /><span>{label("trail")}</span></label>
  </div>
</header>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px clamp(16px, 3vw, 32px);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 700 22px var(--font-round);
  }
  .badge {
    display: inline-block;
    padding: 0 9px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--sea);
    font-size: 18px;
    transform: rotate(-6deg);
  }

  .search-pill {
    flex: 0 1 460px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    padding: 12px 14px 12px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink-3);
    font: 600 15px var(--font-body);
    text-align: left;
    cursor: pointer;
  }
  .search-pill:hover {
    color: var(--ink-2);
  }
  .icon {
    font-size: 20px;
    line-height: 1;
    color: var(--ink-2);
  }
  .search-pill kbd {
    margin-left: auto;
  }

  /* A segmented switch over real radio buttons, which keep their keyboard behaviour (arrows choose). */
  .toggle {
    flex: none;
    display: flex;
    padding: 4px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .toggle label {
    position: relative;
  }
  .toggle input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .toggle span {
    display: block;
    padding: 6px 16px;
    border-radius: 999px;
    color: var(--ink-3);
    font: 700 14px var(--font-round);
  }
  .toggle label:hover span {
    color: var(--ink);
  }
  .toggle input:checked + span {
    background: var(--ink);
    color: var(--card);
  }
  .toggle input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* On a phone the pill is just its icon and the logo just its badge; their text stays as accessible names. */
  @media (max-width: 640px) {
    .search-pill {
      flex: 0 0 auto;
      padding: 10px 14px;
    }
    .site-title,
    .prompt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .search-pill kbd {
      display: none;
    }
  }
</style>
