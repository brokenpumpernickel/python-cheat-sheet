---
// The bar across the top of every view. Later tickets add the search pill (06), the Map | Trail
// toggle (07) and the EN | PL switch (08) here.
import { label } from "../labels";
---

<header class="top-bar">
  <p class="logo"><span class="badge" aria-hidden="true">py</span> {label("siteTitle")}</p>
</header>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px clamp(16px, 3vw, 32px);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 700 22px var(--font-round);
  }
  .badge {
    display: inline-block;
    padding: 0 9px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--sea);
    font-size: 18px;
    transform: rotate(-6deg);
  }
</style>
