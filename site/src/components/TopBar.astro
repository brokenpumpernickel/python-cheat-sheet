---
// The bar across the top of every view, with the search pill (the pop-up itself is Search.astro), the
// Map | Trail toggle (client/arrangement.ts) and the EN | PL switch (client/language.ts), both radio groups.
// The Language buttons read EN and PL whichever Language is shown, each marked with its own lang.
import { labelAttributes } from "../labels";
import Text from "./Text.astro";
---

<header class="top-bar">
  <p class="logo"><span class="badge" aria-hidden="true">py</span> <span class="site-title"><Text label="siteTitle" /></span></p>
  <button class="search-pill" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" data-search-open>
    <span class="icon" aria-hidden="true">⌕</span>
    <span class="prompt"><Text label="searchPrompt" /></span>
    <kbd aria-hidden="true" data-shortcut>Ctrl K</kbd>
  </button>
  <div class="switches">
    <div class="toggle" role="radiogroup" {...labelAttributes({ "aria-label": "arrangement" })}>
      <label><input type="radio" name="arrangement" value="map" autocomplete="off" checked data-arrangement-choice /><span><Text label="map" /></span></label>
      <label><input type="radio" name="arrangement" value="trail" autocomplete="off" data-arrangement-choice /><span><Text label="trail" /></span></label>
    </div>
    <div class="toggle" role="radiogroup" {...labelAttributes({ "aria-label": "language" })}>
      <label lang="en"><input type="radio" name="language" value="en" autocomplete="off" checked data-language-choice /><span>EN</span></label>
      <label lang="pl"><input type="radio" name="language" value="pl" autocomplete="off" data-language-choice /><span>PL</span></label>
    </div>
  </div>
  <script is:inline>
    // Checks the choices the page head's script applied, before the first paint, so the default segments
    // don't show for a moment while the client modules load.
    for (const [name, value] of [["arrangement", document.documentElement.dataset.arrangement], ["language", document.documentElement.lang]]) {
      const choice = document.querySelector(`input[name="${name}"][value="${value}"]`);
      if (choice) choice.checked = true;
    }
  </script>
</header>

<style>
  /* Where the switches don't fit beside the logo and the pill (a narrow phone), they wrap to a second
     row, at its right. */
  .top-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 10px 16px;
    padding: 16px clamp(16px, 3vw, 32px);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 auto 0 0;
    font: 700 22px var(--font-round);
  }
  .badge {
    display: inline-block;
    padding: 0 9px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--sea);
    font-size: 18px;
    transform: rotate(-6deg);
  }

  /* Grows up to its width from nothing, so it never pushes the switches to a row of their own. */
  .search-pill {
    flex: 1 1 0;
    max-width: 460px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px 12px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink-3);
    font: 600 15px var(--font-body);
    text-align: left;
    cursor: pointer;
  }
  .search-pill:hover {
    color: var(--ink-2);
  }
  .icon {
    font-size: 20px;
    line-height: 1;
    color: var(--ink-2);
  }
  .search-pill kbd {
    margin-left: auto;
  }

  .switches {
    flex: none;
    display: flex;
    gap: 8px;
  }

  /* A segmented switch over real radio buttons, which keep their keyboard behaviour (arrows choose). */
  .toggle {
    flex: none;
    display: flex;
    padding: 4px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .toggle label {
    position: relative;
  }
  .toggle input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .toggle span {
    display: block;
    padding: 6px 16px;
    border-radius: 999px;
    color: var(--ink-3);
    font: 700 14px var(--font-round);
  }
  .toggle label:hover span {
    color: var(--ink);
  }
  .toggle input:checked + span {
    background: var(--ink);
    color: var(--card);
  }
  .toggle input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* On a phone the pill is just its icon and the logo just its badge; their text stays as accessible names. */
  @media (max-width: 640px) {
    .search-pill {
      flex: 0 0 auto;
      padding: 10px 14px;
    }
    .site-title,
    .prompt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .search-pill kbd {
      display: none;
    }
    .toggle span {
      padding: 6px 12px;
    }
  }
</style>
