---
// One Topic's page: a header in the Area's hue, sticky chips that jump to its Entries, the Entry cards
// (two columns on wide screens), then Previous / Next stop in Topic order.
// Focus moves to the article (tabindex -1) when the page is zoomed into.
import type { Area, Topic } from "../content";
import { labelAttributes } from "../labels";
import EntryCard, { type SeeAlso } from "./EntryCard.astro";
import Text from "./Text.astro";

interface Stop {
  area: Area;
  topic: Topic;
}

interface Props {
  area: Area;
  topic: Topic;
  previous: Stop | null;
  next: Stop | null;
  links: Map<string, SeeAlso>; // every Entry a See-also may name, by "topic/entry"
}

const { area, topic, previous, next, links } = Astro.props;
---

<article class="topic" data-topic={topic.id} aria-labelledby={`topic-${topic.id}`} tabindex="-1" hidden style={{ "--hue": area.hue }}>
  <header class="hero">
    <a class="home" href="#" data-home>
      <span aria-hidden="true">←</span> <span data-arrangement="map"><Text label="map" /></span><span data-arrangement="trail"><Text label="trail" /></span>
    </a>
    <span class="hero-glyph" aria-hidden="true">{topic.glyph}</span>
    <div class="hero-text">
      <p class="area-name"><Text en={area.title} pl={area.pl.title} /></p>
      <h1 id={`topic-${topic.id}`}><Text en={topic.title} pl={topic.pl.title} /></h1>
      {
        topic.summary && (
          <p class="summary">
            <Text en={topic.summary} pl={topic.pl.summary!} />
          </p>
        )
      }
    </div>
  </header>

  <nav class="chips" {...labelAttributes({ "aria-label": "entries" })} data-chips>
    {
      topic.entries.map((entry) => (
        <a href={`#${topic.id}/${entry.id}`}>
          <Text en={entry.title} pl={entry.pl.title} />
        </a>
      ))
    }
  </nav>

  <div class="cards">
    {topic.entries.map((entry) => <EntryCard topicId={topic.id} entry={entry} see={entry.see.map((ref) => links.get(ref)!)} />)}
  </div>

  {
    (previous || next) && (
      <nav class="stops" {...labelAttributes({ "aria-label": "topicOrder" })}>
        {previous && (
          <a class="stop previous" href={`#${previous.topic.id}`} rel="prev" style={{ "--hue": previous.area.hue }}>
            <small>
              <Text label="previousStop" />
            </small>
            <span aria-hidden="true">←</span> <Text en={previous.topic.title} pl={previous.topic.pl.title} />
          </a>
        )}
        {next && (
          <a class="stop next" href={`#${next.topic.id}`} rel="next" style={{ "--hue": next.area.hue }}>
            <small>
              <Text label="nextStop" />
            </small>
            <Text en={next.topic.title} pl={next.topic.pl.title} /> <span aria-hidden="true">→</span>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .topic {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px clamp(16px, 3vw, 32px) 64px;
  }
  /* Focus moves to the page on zoom-in; a keyboard user sees it on the header rather than around the whole
     page. */
  .topic:focus {
    outline: none;
  }
  .topic:focus-visible .hero {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    padding: 26px 30px;
    border-radius: 32px;
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
  }
  .home {
    position: absolute;
    top: 14px;
    right: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 3px 0 hsl(var(--hue) 40% 45% / 0.35);
    font: 700 14px var(--font-round);
    text-decoration: none;
  }
  .hero-glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 6px 0 hsl(var(--hue) 40% 45% / 0.35);
    font: 700 28px var(--font-mono);
    color: hsl(var(--hue) 60% var(--deep-l));
  }
  /* Takes the room beside the glyph and wraps its lines there, so a long summary doesn't push the whole
     block below the glyph; only where less than 240px is left beside it (a phone) does it go below. */
  .hero-text {
    flex: 1 1 240px;
    min-width: 0;
  }
  .area-name {
    margin: 0;
    font: 800 12px var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--hue) 50% var(--deep-l));
  }
  h1 {
    margin: 2px 0 6px;
    font: 700 clamp(36px, 6vw, 60px)/1 var(--font-round);
    overflow-wrap: anywhere;
  }
  .summary {
    margin: 0;
    font-weight: 600;
    color: var(--ink-2);
  }
  /* The Map | Trail button sits over the header's top-right corner: the Area name keeps clear of it, and
     the title starts below it, so a long title can use the full width. */
  .area-name {
    margin: 0 112px 10px 0;
  }

  /* Stays at the top (below the Index strip on a phone, --sticky-top) while the cards scroll under it;
     client/views.ts scrolls Entries in below it. */
  .chips {
    position: sticky;
    top: var(--sticky-top, 0px);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 0;
    background: linear-gradient(var(--sea) 70%, transparent);
  }
  .chips a {
    flex: none;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
    font: 700 13.5px var(--font-body);
    text-decoration: none;
  }
  .chips a:hover {
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
  }

  .cards {
    columns: 2 440px;
    column-gap: 20px;
    /* The cards are inline-blocks (EntryCard), one per line; the default 2 would keep a two-card Topic
       in one column. */
    orphans: 1;
    widows: 1;
  }

  .stops {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 30px;
  }
  .stop {
    padding: 14px 24px;
    border-radius: 24px;
    background: var(--card);
    box-shadow: var(--shadow);
    font: 700 22px/1.3 var(--font-round);
    text-decoration: none;
    transition: transform 0.15s;
  }
  .stop small {
    display: block;
    font: 800 11px var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .stop.next {
    margin-left: auto;
    text-align: right;
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
    box-shadow: 0 6px 0 hsl(var(--hue) 40% 45% / 0.35);
  }
  .stop.next small {
    color: hsl(var(--hue) 45% var(--deep-l));
  }
  .stop:hover {
    transform: translateY(-2px);
  }

  /* Phones: a shorter header, and one row of chips that scrolls sideways instead of filling the screen. */
  @media (max-width: 600px) {
    .hero {
      padding: 52px 20px 22px;
      border-radius: 26px;
    }
    .hero-glyph {
      width: 64px;
      height: 64px;
      font-size: 20px;
    }
    /* The button has a row of its own above the header's text here. */
    .area-name {
      margin: 0;
    }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 calc(-1 * clamp(16px, 3vw, 32px));
      padding-inline: clamp(16px, 3vw, 32px);
      scrollbar-width: none;
    }
    .stop {
      flex: 1 1 100%;
      font-size: 19px;
    }
  }
</style>
