---
// One Topic's page: a header in the Area's hue, sticky chips that jump to its Entries, the Entry cards
// (two columns on wide screens), then Previous / Next stop in Topic order.
// Focus moves to the article (tabindex -1) when the page is zoomed into.
import type { Area, Topic } from "../content";
import { label } from "../labels";
import EntryCard, { type SeeAlso } from "./EntryCard.astro";

interface Stop {
  area: Area;
  topic: Topic;
}

interface Props {
  area: Area;
  topic: Topic;
  previous: Stop | null;
  next: Stop | null;
  links: Map<string, SeeAlso>; // every Entry a See-also may name, by "topic/entry"
}

const { area, topic, previous, next, links } = Astro.props;
---

<article class="topic" data-topic={topic.id} aria-labelledby={`topic-${topic.id}`} tabindex="-1" hidden style={{ "--hue": area.hue }}>
  <header class="hero">
    <a class="home" href="#" data-home>
      <span aria-hidden="true">←</span> <span data-arrangement="map">{label("map")}</span><span data-arrangement="trail">{label("trail")}</span>
    </a>
    <span class="hero-glyph" aria-hidden="true">{topic.glyph}</span>
    <div>
      <p class="area-name">{area.title}</p>
      <h1 id={`topic-${topic.id}`}>{topic.title}</h1>
      {topic.summary && <p class="summary">{topic.summary}</p>}
    </div>
  </header>

  <nav class="chips" aria-label={label("entries")} data-chips>
    {topic.entries.map((entry) => <a href={`#${topic.id}/${entry.id}`}>{entry.title}</a>)}
  </nav>

  <div class="cards">
    {topic.entries.map((entry) => <EntryCard topicId={topic.id} entry={entry} see={entry.see.map((ref) => links.get(ref)!)} />)}
  </div>

  {
    (previous || next) && (
      <nav class="stops" aria-label={label("topicOrder")}>
        {previous && (
          <a class="stop previous" href={`#${previous.topic.id}`} rel="prev" style={{ "--hue": previous.area.hue }}>
            <small>{label("previousStop")}</small>
            <span aria-hidden="true">←</span> {previous.topic.title}
          </a>
        )}
        {next && (
          <a class="stop next" href={`#${next.topic.id}`} rel="next" style={{ "--hue": next.area.hue }}>
            <small>{label("nextStop")}</small>
            {next.topic.title} <span aria-hidden="true">→</span>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .topic {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px clamp(16px, 3vw, 32px) 64px;
  }
  .topic:focus {
    outline: none;
  }

  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    padding: 26px 30px;
    border-radius: 32px;
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
  }
  .home {
    position: absolute;
    top: 14px;
    right: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 3px 0 hsl(var(--hue) 40% 45% / 0.35);
    font: 700 14px var(--font-round);
    text-decoration: none;
  }
  .hero-glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 6px 0 hsl(var(--hue) 40% 45% / 0.35);
    font: 700 28px var(--font-mono);
    color: hsl(var(--hue) 60% var(--deep-l));
  }
  .area-name {
    margin: 0;
    font: 800 12px var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--hue) 50% var(--deep-l));
  }
  h1 {
    margin: 2px 0 6px;
    font: 700 clamp(36px, 6vw, 60px)/1 var(--font-round);
    overflow-wrap: anywhere;
  }
  .summary {
    margin: 0;
    font-weight: 600;
    color: var(--ink-2);
  }

  /* Stays at the top (below the Index strip on a phone, --sticky-top) while the cards scroll under it;
     client/views.ts scrolls Entries in below it. */
  .chips {
    position: sticky;
    top: var(--sticky-top, 0px);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 0;
    background: linear-gradient(var(--sea) 70%, transparent);
  }
  .chips a {
    flex: none;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow);
    font: 700 13.5px var(--font-body);
    text-decoration: none;
  }
  .chips a:hover {
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
  }

  .cards {
    columns: 2 440px;
    column-gap: 20px;
    padding-top: 12px; /* room for a Pitfall sticker on a column's first card */
  }

  .stops {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 30px;
  }
  .stop {
    padding: 14px 24px;
    border-radius: 24px;
    background: var(--card);
    box-shadow: var(--shadow);
    font: 700 22px/1.3 var(--font-round);
    text-decoration: none;
    transition: transform 0.15s;
  }
  .stop small {
    display: block;
    font: 800 11px var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .stop.next {
    margin-left: auto;
    text-align: right;
    background: hsl(var(--hue) var(--isl-s) var(--isl-l));
    box-shadow: 0 6px 0 hsl(var(--hue) 40% 45% / 0.35);
  }
  .stop.next small {
    color: hsl(var(--hue) 45% var(--deep-l));
  }
  .stop:hover {
    transform: translateY(-2px);
  }

  /* Phones: a shorter header, and one row of chips that scrolls sideways instead of filling the screen. */
  @media (max-width: 600px) {
    .hero {
      padding: 52px 20px 22px;
      border-radius: 26px;
    }
    .hero-glyph {
      width: 64px;
      height: 64px;
      font-size: 20px;
    }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 calc(-1 * clamp(16px, 3vw, 32px));
      padding-inline: clamp(16px, 3vw, 32px);
      scrollbar-width: none;
    }
    .stop {
      flex: 1 1 100%;
      font-size: 19px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stop {
      transition: none;
    }
  }
</style>
