---
// The search pop-up (a modal dialog), opened by the top bar's pill, Ctrl/Cmd+K or "/". The input is a
// combobox over the results list, which client/search.ts fills from the lazily loaded index.
import { label } from "../labels";
---

<dialog class="search" data-search aria-label={label("search")}>
  <input
    class="query"
    type="search"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="search-results"
    aria-label={label("searchPrompt")}
    placeholder={`${label("searchPrompt")}…`}
    autocomplete="off"
    spellcheck="false"
    autofocus
    data-search-input
  />
  <ul id="search-results" class="results" role="listbox" aria-label={label("searchResults")} hidden data-search-results>
  </ul>
  <p class="status" role="status" data-search-status></p>
  <p class="keys" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> {label("searchMove")}</span>
    <span><kbd>Enter</kbd> {label("searchOpen")}</span>
    <span><kbd>Esc</kbd> {label("searchClose")}</span>
  </p>
</dialog>

<style>
  /* The dialog is the box itself (no padding), so a click with the dialog as its target is on the backdrop. */
  .search {
    width: min(600px, calc(100vw - 32px));
    margin: 10vh auto auto;
    padding: 0;
    border: 0;
    border-radius: 28px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.3);
  }
  .search::backdrop {
    background: rgb(20 30 50 / 0.35);
    backdrop-filter: blur(4px);
  }

  .query {
    display: block;
    width: 100%;
    padding: 22px 26px;
    border: 0;
    border-bottom: 2px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 700 20px var(--font-round);
  }
  .query:focus-visible {
    outline: none;
    border-bottom-color: var(--focus);
  }
  .query::placeholder {
    color: var(--ink-3);
  }
  .query::-webkit-search-cancel-button {
    appearance: none; /* Esc closes, and select-all + type replaces */
  }

  .results {
    max-height: 50vh;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    list-style: none;
  }
  .results :global([role="option"]) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 12px;
    padding: 10px 16px;
    border-radius: 16px;
    cursor: pointer;
  }
  .results :global([aria-selected="true"]) {
    background: var(--code-bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }
  .results :global(.title) {
    font: 700 16px var(--font-round);
  }
  .results :global(.path) {
    font: 600 12.5px var(--font-body);
    color: var(--ink-3);
  }

  .status:empty {
    display: none;
  }
  .status {
    margin: 0;
    padding: 16px 26px 4px;
    color: var(--ink-3);
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    padding: 10px 24px 14px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .keys kbd + kbd {
    margin-left: 3px;
  }
  /* Touch screens have no keys to hint at. */
  @media (hover: none) {
    .keys {
      display: none;
    }
  }
</style>
