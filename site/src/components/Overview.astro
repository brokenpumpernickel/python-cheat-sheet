---
// The Overview: the zoomed-out view of the whole cheat sheet, in two arrangements, the Map and the Trail.
// Only the one chosen with the top bar's toggle shows (theme.css). The semantic zoom scales this element
// toward a Topic's tile (any element with data-tile in the visible arrangement).
import type { Area } from "../content";
import MapView from "./MapView.astro";
import Text from "./Text.astro";
import TrailView from "./TrailView.astro";

interface Props {
  areas: Area[];
}

const { areas } = Astro.props;
---

<section class="overview" data-overview aria-labelledby="overview-title">
  <h1 id="overview-title" class="sr-only"><Text label="siteTitle" /></h1>
  <MapView areas={areas} />
  <TrailView areas={areas} />
</section>

<style>
  .overview {
    background-image: radial-gradient(circle at 1px 1px, var(--wave) 1.5px, transparent 0);
    background-size: 26px 26px;
  }
</style>
