---
// The whole cheat sheet is one page: the Overview plus every Topic page, switched by the hash route
// (src/client). Components render everything at build time; the client only shows, hides and animates.
import "../styles/fonts.css"; // Baloo 2, with adjusted metrics
import "@fontsource-variable/nunito";
import "@fontsource-variable/jetbrains-mono";
import "../styles/theme.css";
import Footer from "../components/Footer.astro";
import Overview from "../components/Overview.astro";
import Search from "../components/Search.astro";
import TopBar from "../components/TopBar.astro";
import TopicView from "../components/TopicView.astro";
import { ARRANGEMENT_KEY } from "../client/arrangement";
import { LANGUAGE_KEY, LANGUAGE_PARAM } from "../client/language";
import { loadContent } from "../content";
import { defaultLanguage, label, languages } from "../labels";

const { areas, meta } = loadContent();
const titles = Object.fromEntries(languages.map((language) => [language, label("siteTitle", language)]));
---

<!doctype html>
<html lang={defaultLanguage} data-arrangement="map">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{label("siteTitle")}</title>
    <script is:inline define:vars={{ arrangementKey: ARRANGEMENT_KEY, languageKey: LANGUAGE_KEY, param: LANGUAGE_PARAM, titles }}>
      // The remembered Map | Trail choice (client/arrangement.ts runs the toggle) and the Language, from
      // ?lang= or else the remembered one (client/language.ts runs the switch), applied before the first paint.
      const root = document.documentElement;
      let language = new URLSearchParams(location.search).get(param);
      try {
        if (localStorage.getItem(arrangementKey) === "trail") root.dataset.arrangement = "trail";
        if (!Object.hasOwn(titles, language)) language = localStorage.getItem(languageKey);
      } catch {}
      if (Object.hasOwn(titles, language)) {
        root.lang = language;
        document.title = titles[language];
      }
    </script>
  </head>
  <body>
    <TopBar />
    <main class="stage">
      <Overview areas={areas} />
      <TopicView areas={areas} />
    </main>
    <Footer versions={meta.versions} />
    <Search />

    <script>
      import "../client/main";
    </script>
  </body>
</html>

<style>
  /* The zoom scales the Overview up to four times its size; clip that instead of growing the page. */
  .stage {
    overflow: clip;
  }
</style>
